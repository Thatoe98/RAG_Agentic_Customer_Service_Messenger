# Facebook
FB_PAGE_ACCESS_TOKEN=your_fb_page_access_token
FB_VERIFY_TOKEN=any_random_secret_string_you_choose
FB_APP_SECRET=your_fb_app_secret

# Gemini
GEMINI_API_KEY=AIza...

# RAG / knowledge base (optional — defaults shown)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
DB_PATH=data/knowledge.db

# Admin webapp
ADMIN_PASSWORD=choose_a_strong_password
SESSION_SECRET=long_random_string_for_signing_cookies

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_SUPERVISOR_CHAT_ID=your_chat_id_or_group_id
