# Facebook
FB_PAGE_ACCESS_TOKEN=your_fb_page_access_token
FB_VERIFY_TOKEN=any_random_secret_string_you_choose
FB_APP_SECRET=your_fb_app_secret

# Gemini
GEMINI_API_KEY=AIza...

# Google Drive (path to service account JSON file, or the raw JSON string)
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service_account.json
GOOGLE_DRIVE_FOLDER_ID=optional_shared_folder_id

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_SUPERVISOR_CHAT_ID=your_chat_id_or_group_id
